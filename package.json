{
  "name": "payproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.ts",
    "start": "node --env-file=.env scripts/start.ts",
    "seed": "node --env-file=.env apps/api/src/seed.ts",
    "demo:prepare": "node --env-file=.env scripts/prepare-live-demo.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "vp build && vp pack",
    "postinstall": "node scripts/install-hooks.mjs && vp config --no-agent",
    "test:atlas": "node --env-file=.env node_modules/vite-plus/bin/vp test --config atlas.config.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@apollo/server": "^5.5.2",
    "@conao3/apollo-server-integration-hono": "^0.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hono/node-server": "^2.1.9",
    "graphql": "^16.11.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.74.0",
    "mongodb": "^7.9.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-resolvers": "7.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "msw": "^3.0.6",
    "tailwindcss": "^4.3.5",
    "vite-plus": "1.7.0"
  }
}
